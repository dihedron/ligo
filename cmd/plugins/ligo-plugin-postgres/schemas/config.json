{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "port",
    "database",
    "allowed_endpoints",
    "bootstrap_credential"
  ],
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "database": {
      "type": "string"
    },
    "grantable_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grantable_role_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ca_pem": {
      "type": "string",
      "description": "PEM roots that verify the server and the Vault of bootstrap_credential; the system roots when absent"
    },
    "directory_group": {
      "type": "string"
    },
    "credential_ttl": {
      "type": "string",
      "description": "the lease of a credential issued on demand, such as 15m; ligo's plugins.dynamic_credentials.default_ttl when absent"
    },
    "credential_max_ttl": {
      "type": "string",
      "description": "the longest a lease may be renewed to, such as 4h; ligo's plugins.dynamic_credentials.max_ttl when absent"
    },
    "bootstrap_credential": {
      "type": "object"
    }
  }
}
