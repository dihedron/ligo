# The lab directory (.specs/ligo-test-environment.md, "LDAP"): people, the
# service accounts ligo uses, and the groups of the server.yaml example
# (§8.1), for a data centre, two tenancies and the Information Security
# party. {{PASSWORD:name}} is replaced at "up" with the hash of a random
# password kept in the lab's state directory.

dn: ou=users,dc=ligo,dc=lab
objectClass: organizationalUnit
ou: users

dn: ou=services,dc=ligo,dc=lab
objectClass: organizationalUnit
ou: services

dn: ou=groups,dc=ligo,dc=lab
objectClass: organizationalUnit
ou: groups

dn: ou=ligo-accounts,dc=ligo,dc=lab
objectClass: organizationalUnit
ou: ligo-accounts
description: Principals created by the openldap.v1 identity provider

# --- Service accounts ----------------------------------------------------------

# ligo's administrator authentication (§8.1 admin_auth.ldap, §7.2.1)
dn: cn=ligo-admin-auth,ou=services,dc=ligo,dc=lab
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: ligo-admin-auth
userPassword: {{PASSWORD:ligo-admin-auth}}

# the openldap.v1 identity provider: writes ou=ligo-accounts only
dn: cn=ligo-idp,ou=services,dc=ligo,dc=lab
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: ligo-idp
userPassword: {{PASSWORD:ligo-idp}}

