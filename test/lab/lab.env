# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of the ligo lab (see .specs/ligo-test-environment.md).
#
# Every setting has its default here. To change one for a single machine, set
# it in lab.local.env next to this file (git-ignored); to change it for one
# command, set it in the environment. The environment wins over lab.local.env,
# which wins over this file.

# --- Scenarios ----------------------------------------------------------------

# Default of every command's --scenario. Only "storage" exists for now.
LAB_SCENARIOS="storage"

# --- Versions -----------------------------------------------------------------

# Image of the lab's VMs, as REMOTE:ALIAS.
LAB_IMAGE="ubuntu:24.04"

# --- LXD ----------------------------------------------------------------------

# Project, managed bridge and storage pool the lab creates, and removes on
# "down". The other labs on this host use 10.250.0.0/24 (openstack-spiffe) and
# 10.251.0.0/24 (lxd-spiffe).
LAB_PROJECT="ligo-lab"
LAB_NETWORK="ligo-lab"
LAB_SUBNET="10.252.0.0/24"
LAB_STORAGE_POOL="ligo-lab"
# Driver of the pool: dir (needs nothing on the host), zfs or btrfs (instant
# snapshots, in a loop file of LAB_STORAGE_SIZE). Applies when the pool is
# created.
LAB_STORAGE_DRIVER="dir"
LAB_STORAGE_SIZE="40GiB"

# --- Sizes --------------------------------------------------------------------

# The PostgreSQL VM; applied when it is created.
LAB_PG_CPUS="2"
LAB_PG_MEMORY="2GiB"
LAB_PG_DISK="20GiB"
# Host part of its address in LAB_SUBNET.
LAB_PG_HOST="10"

# --- Locations ----------------------------------------------------------------

# PKI, passwords, env.json (git-ignored); relative to this directory.
LAB_STATE_DIR=".state"

# --- Behaviour ----------------------------------------------------------------

# Answer yes to the confirmation of "down".
LAB_ASSUME_YES="no"
