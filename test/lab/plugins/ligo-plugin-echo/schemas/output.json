{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint",
    "serverId",
    "mode"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "x-ligo-endpoint": true
    },
    "serverId": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "svid",
        "password"
      ]
    },
    "user": {
      "type": "string"
    }
  }
}
