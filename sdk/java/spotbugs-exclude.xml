<FindBugsFilter>
  <!-- the stubs generated from the proto are not ours to fix -->
  <Match><Package name="~ligo\.workload\..*"/></Match>
  <!-- a result carries the error of its check, as the Throwable it is; java-spiffe's bundle is read-only to us -->
  <Match>
    <Class name="io.github.dihedron.ligo.client.FlowResult"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="io.github.dihedron.ligo.client.FlowOptions$Builder"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
